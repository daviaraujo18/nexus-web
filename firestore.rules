rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isProfessional(uid) {
      return isAuthenticated() && exists(/databases/$(database)/documents/professionals/$(uid));
    }

    // ── Students ──────────────────────────────────────────
    match /students/{studentId} {
      allow read: if isOwner(studentId) || isProfessional(request.auth.uid);
      allow write: if isOwner(studentId);
    }

    // ── Professionals ─────────────────────────────────────
    match /professionals/{professionalId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(professionalId);
    }

    // ── Schedule Templates ────────────────────────────────
    match /weeklySchedules/{docId} {
      allow read: if isAuthenticated();
      allow write: if isProfessional(request.auth.uid);
    }

    // ── Schedule Activities (atividades vinculadas a um template) ──
    match /scheduleActivities/{docId} {
      allow read: if isAuthenticated();
      allow write: if isProfessional(request.auth.uid);
    }

    // ── Schedule Instances ────────────────────────────────
    // Aluno lê suas próprias instâncias; profissional lê todas
    match /scheduleInstances/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        isProfessional(request.auth.uid)
      );
      allow write: if isProfessional(request.auth.uid);
    }

    // ── Activity Progress ─────────────────────────────────
    // collectionGroup rule required for cross-collection queries (dashboard)
    match /{path=**}/activityProgress/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        isProfessional(request.auth.uid)
      );
    }

    // ── Schedule Instances (collectionGroup) ──────────────
    match /{path=**}/scheduleInstances/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        isProfessional(request.auth.uid)
      );
    }

    // Aluno lê e escreve apenas seu próprio progresso; profissional cria/atualiza para seus alunos
    match /activityProgress/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        isProfessional(request.auth.uid)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid ||
        isProfessional(request.auth.uid)
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        isProfessional(request.auth.uid)
      );
    }

    // ── Weekly Snapshots ──────────────────────────────────
    match /weeklySnapshots/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        isProfessional(request.auth.uid)
      );
      allow write: if isProfessional(request.auth.uid) || (
        isAuthenticated() && request.resource.data.studentId == request.auth.uid
      );
    }

    // ── GAD-7 Assessments ─────────────────────────────────
    match /gad7Assessments/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        isProfessional(request.auth.uid)
      );
      allow write: if isAuthenticated() &&
        request.resource.data.studentId == request.auth.uid;
    }

    // ── Instance Guards ───────────────────────────────────
    // Apenas profissionais gerenciam guards (protege contra duplicatas)
    match /instanceGuards/{docId} {
      allow read: if isAuthenticated();
      allow write: if isProfessional(request.auth.uid);
    }

    // ── Notifications ─────────────────────────────────────
    match /notifications/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // ── Audit Logs ────────────────────────────────────────
    match /auditLogs/{docId} {
      allow read: if isProfessional(request.auth.uid);
      allow write: if isProfessional(request.auth.uid);
    }

    // ── System Logs / Errors ──────────────────────────────
    match /systemLogs/{docId} {
      allow read, write: if isProfessional(request.auth.uid);
    }

    match /systemErrors/{docId} {
      allow read, write: if isProfessional(request.auth.uid);
    }

    // ── Rate Limits ───────────────────────────────────────
    // Usuário só pode ler/escrever seu próprio documento de rate limit
    match /rate_limits/{docId} {
      allow read, write: if isAuthenticated() && docId == request.auth.uid;
    }

    // ── FCM Tokens ────────────────────────────────────────
    // Usuário só acessa seus próprios tokens
    match /fcmTokens/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ── Everything else: DENY ─────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
